# Secrets (keep the placeholder template)
**/.env
**/.env.*
!**/.env.example

# Virtual environments
**/venv/
**/.venv/

# Git
.git/

# Python bytecode
**/__pycache__/
**/*.py[cod]

# Collected static files (the image runs collectstatic itself)
**/staticfiles/

# Local databases and backups
**/*.sqlite3
**/*.dump
**/*.dump.sha256

# macOS
**/.DS_Store

# Personal notes
readme.txt
