# Copy this file to .env and replace the placeholders.
# Keep the single quotes around the values.
DJANGO_SECRET_KEY='replace-with-a-generated-secret-key'

# Database mode: sqlite (default) or postgres.
DB_ENGINE=sqlite

# Required only when DB_ENGINE=postgres.
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow_user
POSTGRES_PASSWORD='replace-with-your-database-password'
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
