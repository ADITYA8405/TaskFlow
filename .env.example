# Copy this file to .env and replace the placeholders.
# Keep the single quotes around the values.
DJANGO_SECRET_KEY='replace-with-a-generated-secret-key'

# Development mode. Settings default to DEBUG off (production-safe), so local
# development turns it on explicitly. Never set this to true in production.
DJANGO_DEBUG=true

# Production only (used when DJANGO_DEBUG is false). Comma-separated lists.
# DJANGO_ALLOWED_HOSTS=taskflow.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://taskflow.example.com
# Set to true only behind a TLS-terminating proxy that sets X-Forwarded-Proto.
# DJANGO_BEHIND_TLS_PROXY=false
# HTTP is redirected to HTTPS by default.
# DJANGO_SECURE_SSL_REDIRECT=true
# HSTS stays off (0, false, false) until HTTPS is verified on the real domain.
# DJANGO_SECURE_HSTS_SECONDS=0
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# DJANGO_SECURE_HSTS_PRELOAD=false
# Email backend. Defaults to console in development and SMTP in production.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Database mode: sqlite (default) or postgres.
DB_ENGINE=sqlite

# Required only when DB_ENGINE=postgres.
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow_user
POSTGRES_PASSWORD='replace-with-your-database-password'
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# TLS mode, e.g. require for Neon. Unset uses libpq's default (prefer).
# POSTGRES_SSLMODE=require

# Celery broker (Redis). Docker Compose sets its own value for the containers.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
